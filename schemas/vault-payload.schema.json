{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vault-payload.schema.json",
  "title": "CKVF Encrypted payload",
  "$comment": "Non-normative. SPEC.md SComm.AI Draft 0.1 Sections 4.3, 4.5, and 8 are authoritative. These schemas do not replace normative prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "msk",
    "keys",
    "preferred_keys",
    "metadata",
    "tombstones",
    "extensions",
    "critical_extensions"
  ],
  "properties": {
    "identity": {
      "$ref": "identity.schema.json"
    },
    "msk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "history"],
      "properties": {
        "current": {
          "$ref": "#/$defs/mskCurrent"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mskHistoryEntry"
          },
          "description": "Historical MSK public records. Historical MSK private keys MUST NOT be stored."
        }
      }
    },
    "keys": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "key-record.schema.json"
      }
    },
    "preferred_keys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openpgp": { "$ref": "#/$defs/purposeMap" },
        "smime": { "$ref": "#/$defs/purposeMap" }
      },
      "description": "Object keyed by family, then by purpose, whose values are Absolute Key IDs. Omitted families or purposes mean no preference recorded."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": { "$ref": "#/$defs/rfc3339Z" },
        "updated_at": { "$ref": "#/$defs/rfc3339Z" }
      },
      "description": "Unregistered extra keys in metadata MUST be rejected by v1.0 parsers (use extensions instead)."
    },
    "tombstones": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    },
    "extensions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "allOf": [
          { "$ref": "extension.schema.json" },
          {
            "type": "object",
            "required": ["critical"],
            "properties": {
              "critical": { "const": false }
            }
          }
        ]
      }
    },
    "critical_extensions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "allOf": [
          { "$ref": "extension.schema.json" },
          {
            "type": "object",
            "required": ["critical"],
            "properties": {
              "critical": { "const": true }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "base64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "base64urlSha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "rfc3339Z": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "purposeMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sign": { "$ref": "#/$defs/base64urlSha256" },
        "encrypt": { "$ref": "#/$defs/base64urlSha256" },
        "auth": { "$ref": "#/$defs/base64urlSha256" }
      }
    },
    "mskCurrent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["msk_id", "algorithm", "public_key", "private_key", "activated_at"],
      "properties": {
        "msk_id": {
          "$ref": "#/$defs/base64urlSha256",
          "description": "base64url(SHA-256(32-byte Ed25519 public key bytes))."
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "public_key": {
          "$ref": "#/$defs/base64url32",
          "description": "Unpadded base64url of the 32-byte Ed25519 public key (RFC 8032)."
        },
        "private_key": {
          "$ref": "#/$defs/base64url32",
          "description": "Unpadded base64url of the RFC 8032 32-byte seed, not the 64-byte expanded form."
        },
        "activated_at": {
          "$ref": "#/$defs/rfc3339Z"
        }
      }
    },
    "mskHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["msk_id", "algorithm", "public_key", "activated_at", "retired_at"],
      "properties": {
        "msk_id": { "$ref": "#/$defs/base64urlSha256" },
        "algorithm": { "const": "Ed25519" },
        "public_key": { "$ref": "#/$defs/base64url32" },
        "activated_at": { "$ref": "#/$defs/rfc3339Z" },
        "retired_at": { "$ref": "#/$defs/rfc3339Z" }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_key_id", "deleted_at", "nonce", "reason"],
      "properties": {
        "absolute_key_id": { "$ref": "#/$defs/base64urlSha256" },
        "deleted_at": { "$ref": "#/$defs/rfc3339Z" },
        "nonce": {
          "$ref": "#/$defs/base64url32",
          "description": "Unpadded base64url of 32 octets."
        },
        "reason": {
          "type": "string",
          "enum": ["user-requested", "compromised-purge", "policy"]
        }
      }
    }
  }
}
