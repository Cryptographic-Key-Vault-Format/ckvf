{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signed-operation.schema.json",
  "title": "CKVF Signed operation envelope",
  "$comment": "Non-normative. SPEC.md Community Draft 0.1 Section 4.7 and Appendix B are authoritative. These schemas do not replace normative prose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "payload", "signature"],
  "properties": {
    "body": {
      "$ref": "#/$defs/body"
    },
    "payload": {
      "type": "object",
      "description": "Operation-specific object. Additional members MUST be rejected unless placed in a registered extension object inside payload where a payload schema allows extensions. See Appendix B."
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "ADD_KEY" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadAddKey" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "RETIRE_KEY" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadRetireKey" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "REVOKE_KEY" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadRevokeKey" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "SET_PREFERRED_KEY" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadSetPreferredKey" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "ADD_DEVICE" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadAddDevice" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "REMOVE_DEVICE" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadRemoveDevice" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "COMMIT_VAULT_GENERATION" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadCommitVaultGeneration" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "MERGE_VAULT" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadMergeVault" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "UPDATE_METADATA" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadUpdateMetadata" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "DELETE_PRIVATE_KEY" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadDeletePrivateKey" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "ESTABLISH_MSK" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadEstablishOrReplaceMsk" } }
      }
    },
    {
      "if": {
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["operation"],
            "properties": { "operation": { "const": "REPLACE_MSK" } }
          }
        }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/payloadEstablishOrReplaceMsk" } }
      }
    }
  ],
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "base64url16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 22,
      "maxLength": 22
    },
    "base64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "base64url64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 86,
      "maxLength": 86
    },
    "base64urlSha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "rfc3339Z": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "protocol_version",
        "operation",
        "identity_id",
        "vault_id",
        "generation",
        "nonce",
        "timestamp",
        "payload_hash"
      ],
      "properties": {
        "protocol": { "const": "CKVF" },
        "protocol_version": { "const": "1.0" },
        "operation": {
          "type": "string",
          "enum": [
            "ADD_KEY",
            "RETIRE_KEY",
            "REVOKE_KEY",
            "SET_PREFERRED_KEY",
            "ADD_DEVICE",
            "REMOVE_DEVICE",
            "COMMIT_VAULT_GENERATION",
            "MERGE_VAULT",
            "UPDATE_METADATA",
            "DELETE_PRIVATE_KEY",
            "ESTABLISH_MSK",
            "REPLACE_MSK"
          ]
        },
        "identity_id": { "$ref": "#/$defs/base64urlSha256" },
        "vault_id": { "$ref": "#/$defs/base64url16" },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Generation the operation is intended to apply to, or the generation being committed, as defined per operation."
        },
        "nonce": {
          "$ref": "#/$defs/base64url32",
          "description": "Unpadded base64url of 32 CSPRNG octets."
        },
        "timestamp": { "$ref": "#/$defs/rfc3339Z" },
        "payload_hash": {
          "$ref": "#/$defs/base64urlSha256",
          "description": "unpadded base64url(SHA-256(UTF-8 JCS(payload)))."
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "msk_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "msk_id": { "$ref": "#/$defs/base64urlSha256" },
        "value": {
          "$ref": "#/$defs/base64url64",
          "description": "Unpadded base64url of the 64-byte Ed25519 signature over UTF-8 JCS(body)."
        }
      }
    },
    "familyRevocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data"],
      "properties": {
        "encoding": { "type": "string", "minLength": 1 },
        "data": {
          "$ref": "#/$defs/base64url",
          "description": "Native revocation bytes as unpadded base64url."
        }
      }
    },
    "payloadAddKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "$ref": "key-record.schema.json" }
      }
    },
    "payloadRetireKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_key_id", "status"],
      "properties": {
        "absolute_key_id": { "$ref": "#/$defs/base64urlSha256" },
        "status": { "const": "retired" },
        "family_revocation": { "$ref": "#/$defs/familyRevocation" }
      }
    },
    "payloadRevokeKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_key_id", "status"],
      "properties": {
        "absolute_key_id": { "$ref": "#/$defs/base64urlSha256" },
        "status": { "const": "revoked" },
        "family_revocation": { "$ref": "#/$defs/familyRevocation" }
      }
    },
    "payloadSetPreferredKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "purpose", "absolute_key_id"],
      "properties": {
        "family": { "type": "string", "enum": ["openpgp", "smime"] },
        "purpose": { "type": "string", "enum": ["sign", "encrypt", "auth"] },
        "absolute_key_id": {
          "anyOf": [
            { "$ref": "#/$defs/base64urlSha256" },
            { "type": "null" }
          ],
          "description": "MAY be JSON null to clear a preference."
        }
      }
    },
    "payloadAddDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "slot"],
      "properties": {
        "slot_id": { "$ref": "#/$defs/base64url16" },
        "slot": { "$ref": "unlock-slot.schema.json" }
      }
    },
    "payloadRemoveDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id"],
      "properties": {
        "slot_id": { "$ref": "#/$defs/base64url16" }
      }
    },
    "payloadCommitVaultGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "previous_generation_hash", "generation_hash"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "previous_generation_hash": {
          "anyOf": [
            { "$ref": "#/$defs/base64urlSha256" },
            { "type": "null" }
          ]
        },
        "generation_hash": { "$ref": "#/$defs/base64urlSha256" }
      }
    },
    "payloadMergeVault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parents", "result_generation", "result_generation_hash"],
      "properties": {
        "parents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generation", "generation_hash"],
            "properties": {
              "generation": { "type": "integer", "minimum": 1 },
              "generation_hash": { "$ref": "#/$defs/base64urlSha256" }
            }
          }
        },
        "result_generation": { "type": "integer", "minimum": 1 },
        "result_generation_hash": { "$ref": "#/$defs/base64urlSha256" }
      }
    },
    "payloadUpdateMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updated_at"],
      "properties": {
        "updated_at": { "$ref": "#/$defs/rfc3339Z" }
      }
    },
    "payloadDeletePrivateKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_key_id", "reason"],
      "properties": {
        "absolute_key_id": { "$ref": "#/$defs/base64urlSha256" },
        "reason": {
          "type": "string",
          "enum": ["user-requested", "compromised-purge", "policy"]
        }
      }
    },
    "payloadEstablishOrReplaceMsk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "msk_id",
        "algorithm",
        "public_key",
        "activated_at",
        "verification_method",
        "proof_id"
      ],
      "properties": {
        "msk_id": { "$ref": "#/$defs/base64urlSha256" },
        "algorithm": { "const": "Ed25519" },
        "public_key": { "$ref": "#/$defs/base64url32" },
        "activated_at": { "$ref": "#/$defs/rfc3339Z" },
        "verification_method": {
          "type": "string",
          "minLength": 1,
          "description": "Community-registry Identity Verification Method. v1.0: email-otp, dns-01. The ownership secret MUST NOT appear in payload."
        },
        "proof_id": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque identifier of the consumed proof; not the secret."
        }
      }
    }
  }
}
